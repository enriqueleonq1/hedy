 class Loader(unittest.TestCase):
+    def test_holiday_entries_close_their_day(self):
+        # The JSON stores ISO strings; the calendar must compare them as dates.
+        entries = [{"date": "2025-03-03"}]
+        calendar = ClosureCalendar(holidays=holiday_dates(entries, "centro"))
+        self.assertFalse(calendar.is_open(date(2025, 3, 3)))
+        self.assertTrue(calendar.is_open(date(2025, 3, 5)))
+
