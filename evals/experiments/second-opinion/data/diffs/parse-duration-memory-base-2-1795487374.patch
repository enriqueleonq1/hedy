 """Duraciones del formulario de pausas."""
+import re
+
+_DURATION_RE = re.compile(r"(?:(\d+)\s*h)?\s*(?:(\d+)\s*m)?", re.IGNORECASE)
+
+
+def parse_duration(text):
+    """'1h30m' -> 90, '2h' -> 120, '45m' -> 45, '90' -> 90 (minutos)."""
+    cleaned = text.strip()
+    if re.fullmatch(r"\d+", cleaned):
+        return int(cleaned)
+    match = _DURATION_RE.fullmatch(cleaned)
+    if not cleaned or match is None or (match.group(1) is None and match.group(2) is None):
+        raise ValueError(f"Duración no válida: {text!r}")
+    hours, minutes = match.groups(default="0")
+    return int(hours) * 60 + int(minutes)
 
 
