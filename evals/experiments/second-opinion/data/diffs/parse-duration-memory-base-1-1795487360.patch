+class ParseTest(unittest.TestCase):
+    def test_parses_common_formats(self):
+        self.assertEqual(parse_duration("1h30m"), 90)
+        self.assertEqual(parse_duration("45m"), 45)
+        self.assertEqual(parse_duration("2h"), 120)
+
+    def test_tolerates_spaces_and_case(self):
+        self.assertEqual(parse_duration(" 1h 30m "), 90)
+        self.assertEqual(parse_duration("1H30M"), 90)
+        self.assertEqual(parse_duration("0m"), 0)
+
+    def test_round_trips_with_format_minutes(self):
+        for minutes in (0, 1, 45, 60, 90, 125):
+            with self.subTest(minutes=minutes):
+                self.assertEqual(parse_duration(format_minutes(minutes)), minutes)
+
+    def test_rejects_invalid_input(self):
+        for text in ("", "   ", "h", "m", "30m1h", "1.5h", "abc", "90"):
+            with self.subTest(text=text):
+                with self.assertRaises(ValueError):
+                    parse_duration(text)
