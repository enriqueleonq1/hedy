 """Costo de envío de un pedido."""
 
 
+def _tarifa(weight_kg, base, por_kg, pesado_desde, recargo):
+    # Tarifa base + tarifa por kilo, con recargo si el peso supera el límite.
+    cost = base + por_kg * weight_kg
+    if weight_kg > pesado_desde:
+        cost += recargo
+    return round(cost, 2)
