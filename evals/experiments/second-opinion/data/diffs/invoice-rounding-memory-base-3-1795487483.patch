@@ -1,12 +1,26 @@
 """Facturas: cada línea es precio x cantidad menos un descuento en porcentaje."""
 
+from decimal import ROUND_HALF_UP, Decimal
+
+CENT = Decimal("0.01")
+
+
+def _decimal(value):
+    # str() conserva el valor tal como se escribe (2.675 sigue siendo 2.675),
+    # mientras que Decimal(float) arrastraría el error binario de la coma flotante.
+    return Decimal(str(value))
+
+
+def _line_amount(price, qty, discount_pct=0):
+    total = _decimal(price) * _decimal(qty) * (1 - _decimal(discount_pct) / 100)
+    return total.quantize(CENT, rounding=ROUND_HALF_UP)
+
 
 def line_total(price, qty, discount_pct=0):
-    """El importe de una línea, a 2 decimales."""
-    total = price * qty * (1 - discount_pct / 100)
-    return round(total, 2)
+    """El importe de una línea, a 2 decimales (mitad hacia arriba)."""
+    return float(_line_amount(price, qty, discount_pct))
 
 
 def invoice_total(lines):
     """La suma de las líneas, cada una ya redondeada."""
-    return round(sum(line_total(**line) for line in lines), 2)
+    return float(sum(_line_amount(**line) for line in lines))
