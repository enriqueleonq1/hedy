 """Duraciones del formulario de pausas."""
 
+import re
+
+_DURATION = re.compile(
+    r"""
+    ^\s*
+    (?:(?P<h>\d+)\s*h(?:oras?)?\s*)?
+    (?:(?P<m>\d+)\s*(?:m(?:in(?:utos?)?)?)?\s*)?
+    $
+    """,
+    re.VERBOSE | re.IGNORECASE,
+)
+
 
 def format_minutes(minutes):
     """90 -> '1h30m'."""
@@ -7,3 +19,13 @@ def format_minutes(minutes):
     if hours and rest:
         return f"{hours}h{rest}m"
     return f"{hours}h" if hours else f"{rest}m"
+
+
+def parse_duration(text):
+    """'1h30m' -> 90, '45m' -> 45, '2h' -> 120. Lanza ValueError si no se entiende."""
+    match = _DURATION.match(text) if isinstance(text, str) else None
+    if not match or (match.group("h") is None and match.group("m") is None):
+        raise ValueError(f"Duración no válida: {text!r}")
+    hours = int(match.group("h") or 0)
+    minutes = int(match.group("m") or 0)
+    return hours * 60 + minutes
