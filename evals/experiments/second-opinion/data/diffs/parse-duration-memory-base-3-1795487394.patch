+
+
+class ParseTest(unittest.TestCase):
+    def test_parses_common_forms(self):
+        self.assertEqual(parse_duration("1h30m"), 90)
+        self.assertEqual(parse_duration("45m"), 45)
+        self.assertEqual(parse_duration("2h"), 120)
+
+    def test_parses_spelled_out_units(self):
+        self.assertEqual(parse_duration("1 hora 30 minutos"), 90)
+        self.assertEqual(parse_duration("2 horas"), 120)
+        self.assertEqual(parse_duration("15 min"), 15)
+
+    def test_tolerates_spaces_and_case(self):
+        self.assertEqual(parse_duration("  1H 30M "), 90)
+        self.assertEqual(parse_duration("1h 30m"), 90)
+
+    def test_hours_followed_by_bare_minutes(self):
+        self.assertEqual(parse_duration("1h30"), 90)
+
+    def test_zero(self):
+        self.assertEqual(parse_duration("0m"), 0)
+
+    def test_rejects_invalid(self):
+        for text in ["", "   ", "h", "m", "abc", "1x30m", "-5m", "1.5h", None]:
+            with self.subTest(text=text):
+                with self.assertRaises(ValueError):
+                    parse_duration(text)
+
+    def test_roundtrip_with_format(self):
+        for minutes in [0, 1, 45, 60, 90, 125]:
+            with self.subTest(minutes=minutes):
+                self.assertEqual(parse_duration(format_minutes(minutes)), minutes)
+
+
+if __name__ == "__main__":
+    unittest.main()
