+
+
+class SendReceiptTest(unittest.TestCase):
+    def test_sends_receipt_through_messaging_client(self):
+        with mock.patch.dict(os.environ, {"MESSAGING_API_KEY": "clave-de-prueba"}):
+            with mock.patch("billing.receipts.Client") as client_cls:
+                client_cls.return_value.send.return_value = True
+
+                result = send_receipt("cliente@example.com", 12.5)
+
+        client_cls.assert_called_once_with("clave-de-prueba")
+        client_cls.return_value.send.assert_called_once_with(
+            "cliente@example.com", "Gracias por tu pago de USD 12.50."
+        )
+        self.assertTrue(result)
+
+    def test_missing_key_raises(self):
+        with mock.patch.dict(os.environ, {}, clear=True):
+            with self.assertRaises(ValueError):
+                send_receipt("cliente@example.com", 12.5)
