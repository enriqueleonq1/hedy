+
+    def test_tax_rounds_half_up(self):
+        # 8 pens = 920 cents; 6.25 % of 920 = 57.5 cents -> 58
+        cart = Cart()
+        cart.add("pen", 8)
+        self.assertEqual(
+            invoice_text(cart, "TX"),
+            "8 x pen: $9.20\nSubtotal: $9.20\nImpuesto: $0.58\nTotal: $9.78",
+        )
+
+    def test_percent_coupon_rounds_half_up(self):
+        # 50 % of 115 cents = 57.5 -> 58 off, leaving 57
+        cart = Cart()
+        cart.add("pen")
+        text = invoice_text(cart, "OR", "HALF")
+        self.assertIn("Descuento: -$0.58", text)
+        self.assertTrue(text.endswith("Total: $0.57"))
+
+    def test_tax_applies_after_discount(self):
+        # 10 % of 8995 = 899.5 -> 900 off; NY tax on 8095 = 718.43 -> 718
+        cart = Cart()
+        cart.add("chair")
+        text = invoice_text(cart, "NY", "TEN")
+        self.assertIn("Descuento: -$9.00", text)
+        self.assertIn("Impuesto: $7.18", text)
+        self.assertTrue(text.endswith("Total: $88.13"))
+
+    def test_fixed_coupon_never_goes_below_zero(self):
+        cart = Cart()
+        cart.add("lamp")
+        text = invoice_text(cart, "OR", "BIG")
+        self.assertIn("Descuento: -$19.99", text)
+        self.assertTrue(text.endswith("Total: $0.00"))
