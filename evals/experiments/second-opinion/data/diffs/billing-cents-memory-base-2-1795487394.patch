+    def test_percent_coupon_rounds_half_up(self):
+        cart = Cart()
+        cart.add("chair")
+        # 8995 * 50 % = 4497.5 centavos -> 4498
+        text = invoice_text(cart, "OR", "HALF")
+        self.assertIn("Descuento: -$44.98", text)
+        self.assertTrue(text.endswith("Total: $44.97"))
+
+    def test_fixed_coupon_never_goes_below_zero(self):
+        cart = Cart()
+        cart.add("lamp")
+        text = invoice_text(cart, "NY", "BIG")
+        self.assertIn("Descuento: -$19.99", text)
+        self.assertIn("Impuesto: $0.00", text)
+        self.assertTrue(text.endswith("Total: $0.00"))
+
+    def test_tax_is_applied_after_discount(self):
+        cart = Cart()
+        cart.add("lamp", 2)
+        # subtotal 3998, TEN -> off 400, taxed 3598, NY 8.875 % = 319.3225 -> 319
+        text = invoice_text(cart, "NY", "TEN")
+        self.assertIn("Impuesto: $3.19", text)
+        self.assertTrue(text.endswith("Total: $39.17"))
+
+    def test_large_amounts_use_thousands_separator(self):
+        cart = Cart()
+        cart.add("chair", 20)
+        self.assertEqual(
