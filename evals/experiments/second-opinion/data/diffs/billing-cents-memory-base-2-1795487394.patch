diff --git a/billing/money.py b/billing/money.py
new file mode 100644
index 0000000..d2e7498
--- /dev/null
+++ b/billing/money.py
@@ -0,0 +1,12 @@
+# Todo el dinero del módulo billing se maneja en centavos (int).
+# Las tasas se expresan en partes por millón (ppm) para no usar float.
+PPM = 1_000_000
+
+
+def div_half_up(numerator, denominator):
+    """Divide enteros redondeando al entero más cercano; la mitad sube."""
+    return (2 * numerator + denominator) // (2 * denominator)
+
+
+def money(cents):
+    return f"${cents // 100:,}.{cents % 100:02d}"
