+def attachment(name):
+    # Only plain file names: the path is already percent-decoded, so "..%2f" arrives as "../".
+    if name in ("", ".", "..") or "/" in name or "\\" in name:
+        return 404, "not found"
+    path = config.UPLOAD_DIR / name
+    if not path.is_file():
+        return 404, "not found"
+    return 200, path.read_text()
+
+
 ROUTES = {
     "/health": health,
     "/invoices/": invoice,
+    "/attachments/": attachment,
 }
 
 
