+def read_until(stream_i: Iterator[int], end_char: int, escape: bool = True) -> bytearray:
+    """Read from *stream_i* up to and including *end_char*.
+
+    If *escape* is true, a backslash escapes the following backslash or
+    *end_char*; any other backslash sequence is left untouched.
+    """
+    token = bytearray()
+    try:
+        for nextchar in stream_i:
+            if escape and nextchar == BACKSLASH:
+                escaper = nextchar
+                nextchar = next(stream_i)
+                if nextchar != escaper and nextchar != end_char:
+                    token.append(escaper)  # Don't touch invalid escaping
+            elif nextchar == end_char:
+                break
+            token.append(nextchar)
+        else:
+            raise ValueError("No closing '%s'" % chr(end_char))
+    except StopIteration:
+        raise ValueError("No closing '%s'" % chr(end_char))
+    token.append(end_char)
+    return token
+
