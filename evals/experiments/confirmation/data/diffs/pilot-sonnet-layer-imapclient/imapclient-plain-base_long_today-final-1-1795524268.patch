+def assert_imap_protocol(condition: bool, message: Optional[bytes] = None) -> None:
+    if not condition:
+        msg = "Server replied with a response that violates the IMAP protocol"
+        if message:
+            msg += f": {to_unicode(message)}"
+        raise exceptions.ProtocolError(msg)
