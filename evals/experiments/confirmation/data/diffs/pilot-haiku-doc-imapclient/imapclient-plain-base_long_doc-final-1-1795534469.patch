+_TupleAtom = Tuple[Union[_TupleAtomPart, '_TupleAtom'], ...]
+T = TypeVar('T')
+
+def assert_imap_protocol(condition: Any, msg: Optional[Any]=None) -> None:
+    """Raise ProtocolError if *condition* is false."""
+    if not condition:
+        if msg:
+            msg = '%r' % msg
+        raise exceptions.ProtocolError(msg)
+
+def to_bytes(s: Union[str, bytes], charset: str='ascii') -> bytes:
+    """Convert *s* to bytes using *charset*. Bytes input is returned unchanged."""
+    if isinstance(s, str):
+        return s.encode(charset)
+    return s
+
+def to_unicode(s: Union[str, bytes]) -> str:
+    """Convert *s* to str, decoding bytes as ASCII. str input is returned unchanged."""
+    if isinstance(s, bytes):
+        return s.decode('ascii')
+    return s
+
+def chunk(lst: List[T], size: int) -> Iterator[List[T]]:
+    """Yield successive *size* sized chunks from *lst*."""
+    for i in range(0, len(lst), size):
+        yield lst[i:i + size]
+
+def quote_mailbox(name: str) -> str:
+    """Return the mailbox *name* in double quotes, ready for an IMAP command.
+
+    Every backslash and double quote in *name* is preceded by a backslash::
+
+        >>> quote_mailbox('Sent "old"')
+        '"Sent \\\\"old\\\\""'
+    """
+    escaped = name.replace('\\', '\\\\').replace('"', '\\"')
+    return '"%s"' % escaped
