+    @classmethod
+    def create(cls, response):
+        """Create a BodyData from the parsed *response* tuple, converting
+        any nested parts of a multipart body to BodyData instances.
+        """
+        if not isinstance(response, tuple) or not response or not isinstance(response[0], tuple):
+            return cls(response)
+        parts = []
+        i = 0
+        while i < len(response) and isinstance(response[i], tuple):
+            parts.append(cls.create(response[i]))
+            i += 1
+        return cls((tuple(parts),) + tuple(response[i:]))
