+    @property
+    def is_multipart(self) -> bool:
+        """``True`` if this is a multipart body."""
+        return isinstance(self[0], tuple)
+
+    @property
+    def parts(self) -> Tuple['BodyData', ...]:
+        """The parts of a multipart body, or an empty tuple otherwise."""
+        return self[0] if self.is_multipart else ()
+
+    @property
+    def content_type(self) -> str:
