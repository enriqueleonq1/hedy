+def _read_input(filenames, encoding):
+    """Return the text of all *filenames* concatenated ("-" is stdin)."""
+    chunks = []
+    for filename in filenames:
+        if filename == '-':
+            wrapper = TextIOWrapper(sys.stdin.buffer, encoding=encoding)
+            try:
+                chunks.append(wrapper.read())
+            finally:
+                wrapper.detach()
+        else:
+            with open(filename, encoding=encoding) as f:
+                chunks.append(f.read())
+    return ''.join(chunks)
+
+
+def main(*args):
+    """Command-line interface (see sqlformat(1))."""
+    parser = create_parser()
+    args = parser.parse_args(args or None)
+
+    try:
+        data = _read_input(args.filename, args.encoding)
+    except OSError as e:
+        return _error('Failed to read {}: {}'.format(', '.join(args.filename), e))
+
+    if args.outfile:
+        try:
+            stream = open(args.outfile, 'w', encoding=args.encoding)
+        except OSError as e:
+            return _error('Failed to open {}: {}'.format(args.outfile, e))
+        close_stream = True
+    else:
+        stream = sys.stdout
+        close_stream = False
+
+    formatter_opts = vars(args)
+    for key in ('filename', 'outfile', 'verbose', 'encoding'):
+        formatter_opts.pop(key)
+    try:
+        formatter_opts = sqlparse.formatter.validate_options(formatter_opts)
+    except SQLParseError as e:
+        if close_stream:
+            stream.close()
+        return _error('Invalid options: {}'.format(e))
+
+    s = sqlparse.format(data, **formatter_opts)
+    stream.write(s)
+    stream.flush()
+    if close_stream:
+        stream.close()
+    return 0
