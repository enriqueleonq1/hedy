+        if not getattr(conf, "ssl_check_hostname", True):
+            ssl_context.check_hostname = False
+        if not getattr(conf, "ssl_verify_cert", True):
+            ssl_context.verify_mode = ssl.CERT_NONE
+        ca_file = getattr(conf, "ssl_ca_file", None)
+        if ca_file:
