+        conf.host,
+        port=getattr(conf, "port", None),
+        ssl=conf.ssl,
+        ssl_context=ssl_context,
+        stream=getattr(conf, "stream", False),
+        timeout=getattr(conf, "timeout", None),
+    )
+    if not conf.ssl and getattr(conf, "starttls", False):
+        client.starttls(ssl_context)
+    if login:
+        if getattr(conf, "oauth2", False):
+            access_token = get_oauth2_token(
+                conf.host, conf.oauth2_client_id, conf.oauth2_client_secret, conf.oauth2_refresh_token
+            )
