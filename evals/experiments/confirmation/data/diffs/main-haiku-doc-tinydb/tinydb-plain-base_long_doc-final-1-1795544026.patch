+def chunked(iterable: Iterable[T], size: int) -> List[List[T]]:
+    """
+    Split an iterable into consecutive lists of ``size`` elements. The last
+    list holds the remaining elements and may be shorter.
+
+    >>> chunked([1, 2, 3], 2)
+    [[1, 2], [3]]
+
+    :param iterable: The elements to split.
+    :param size: The maximum number of elements per list. Must be at least 1.
+    :raises ValueError: If ``size`` is less than 1.
+    """
+    if size < 1:
+        raise ValueError('size must be at least 1')
+
+    items = list(iterable)
+    return [items[i:i + size] for i in range(0, len(items), size)]
