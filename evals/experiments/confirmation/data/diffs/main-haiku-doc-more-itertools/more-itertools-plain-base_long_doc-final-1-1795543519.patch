index 0000000..476e48c
--- /dev/null
+++ b/_impl_tmp/ie_search.py
@@ -0,0 +1,32 @@
+from fractions import Fraction as F
+cases = [
+    ([[1,2,3,4,5],['a','b']], [1,2,'a',3,4,'b',5]),
+    ([[1,2,3],[4,5],[6,7,8]], [1,6,4,2,7,3,8,5]),
+    ([list(range(4)), None], None),
+]
+def merge(its, a, b, tie_desc):
+    # its: list of lists, sorted by length desc (stable)
+    order = sorted(range(len(its)), key=lambda i: len(its[i]), reverse=True)
+    lists = [its[i] for i in order]
+    cnt = [0]*len(lists)
+    out = []
+    total = sum(len(l) for l in lists)
+    while len(out) < total:
+        best = None
+        for j, l in enumerate(lists):
+            if cnt[j] < len(l):
+                key = F(cnt[j] + a, len(l) + b)
+                cand = (key, -j if tie_desc else j)
+                if best is None or cand < best[0]:
+                    best = (cand, j)
+        j = best[1]
+        out.append(lists[j][cnt[j]]); cnt[j] += 1
+    return out
+for a in [0, F(1,2), 1, -F(1,2)]:
+    for b in [0, 1, -1]:
+        for tie in [False, True]:
+            ok = True
+            for its, exp in cases[:2]:
+                if merge(its, a, b, tie) != exp: ok = False
+            if ok: print('MATCH', a, b, tie)
+print('done')
