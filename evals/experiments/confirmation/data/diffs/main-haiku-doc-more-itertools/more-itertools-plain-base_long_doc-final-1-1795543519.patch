index 0000000..b0ab9ea
--- /dev/null
+++ b/_impl_tmp/splice.py
@@ -0,0 +1,52 @@
+"""Sustituye el `pass` de cada función indicada por su cuerpo.
+
+Uso: python3 splice.py <modulo.py> <bodies.txt>
+Formato de bodies.txt: bloques que empiezan por "@@ nombre" (Clase.metodo si aplica),
+con el cuerpo dedentado (indentación relativa 0).
+"""
+import ast
+import sys
+
+path, bodies_path = sys.argv[1], sys.argv[2]
+bodies = {}
+current = None
+for line in open(bodies_path).read().split('\n'):
+    if line.startswith('@@ '):
+        current = line[3:].strip()
+        bodies[current] = []
+    elif current is not None:
+        bodies[current].append(line)
+for k in bodies:
+    while bodies[k] and bodies[k][-1] == '':
+        bodies[k].pop()
+
+src = open(path).read()
+lines = src.split('\n')
+tree = ast.parse(src)
+
+targets = {}
+def collect(body, prefix=''):
+    for node in body:
+        if isinstance(node, ast.FunctionDef):
+            targets[prefix + node.name] = node
+        elif isinstance(node, ast.ClassDef):
+            collect(node.body, prefix + node.name + '.')
+collect(tree.body)
+
+edits = []
+for name, body in bodies.items():
+    node = targets.get(name)
+    if node is None:
+        sys.exit(f'no existe {name}')
+    passes = [s for s in node.body if isinstance(s, ast.Pass)]
+    if len(passes) != 1:
+        sys.exit(f'{name}: se esperaba un solo pass, hay {len(passes)}')
+    p = passes[0]
+    indent = ' ' * p.col_offset
+    new = [(indent + l) if l.strip() else '' for l in body]
+    edits.append((p.lineno - 1, new, name))
+
+for idx, new, name in sorted(edits, reverse=True):
+    lines[idx:idx + 1] = new
+open(path, 'w').write('\n'.join(lines))
+print(f'{len(edits)} funciones actualizadas en {path}')
