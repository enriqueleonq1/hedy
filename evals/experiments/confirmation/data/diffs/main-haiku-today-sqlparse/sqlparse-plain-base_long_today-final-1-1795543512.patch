+def main(args=None):
+    """Runs the ``sqlformat`` command and returns the exit code."""
+    parser = create_parser()
+    args = parser.parse_args(args)
+
+    if args.filename == '-':  # read from stdin
+        wrapper = TextIOWrapper(sys.stdin.buffer, encoding=args.encoding)
+        try:
+            data = wrapper.read()
+        finally:
+            wrapper.detach()
+    else:
+        try:
+            with open(args.filename, encoding=args.encoding) as f:
+                data = f.read()
+        except OSError as e:
+            _error('Failed to read {}: {}'.format(args.filename, e), exit_=1)
+
+    if args.outfile:
+        try:
+            stream = open(args.outfile, 'w', encoding=args.encoding)
+        except OSError as e:
+            _error('Failed to open {}: {}'.format(args.outfile, e), exit_=1)
+    else:
+        stream = sys.stdout
+
+    formatter_opts = {
+        key: value for key, value in vars(args).items()
+        if key not in ('filename', 'outfile', 'encoding', 'verbose')
+    }
+    try:
+        formatter_opts = sqlparse.formatter.validate_options(formatter_opts)
+    except SQLParseError as e:
+        _error('Invalid options: {}'.format(e), exit_=1)
+
+    s = sqlparse.format(data, **formatter_opts)
+    stream.write(s)
+    stream.flush()
+    if stream is not sys.stdout:
+        stream.close()
+    return 0
