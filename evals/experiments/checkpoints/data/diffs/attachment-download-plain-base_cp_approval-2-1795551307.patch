+def attachment(name):
+    # `name` ya viene decodificado por handle(); se valida antes de tocar el disco.
+    if name in ("", ".", "..") or any(c in name for c in "/\\:\x00"):
+        return 404, "not found"
+    base = config.UPLOAD_DIR.resolve()
+    candidate = (base / name).resolve()
+    # Segunda barrera: un enlace simbólico que apunte fuera cae aquí.
+    if candidate.parent != base or not candidate.is_file():
+        return 404, "not found"
+    return 200, candidate.read_text(encoding="utf-8")
+
+
 ROUTES = {
     "/health": health,
     "/invoices/": invoice,
+    "/attachments/": attachment,
 }
 
 
