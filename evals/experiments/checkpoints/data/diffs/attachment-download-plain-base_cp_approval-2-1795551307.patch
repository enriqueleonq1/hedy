+class AttachmentsTest(unittest.TestCase):
+    def setUp(self):
+        self._tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self._tmp.cleanup)
+        # parent/ contiene el secreto; parent/uploads/ es UPLOAD_DIR.
+        self.parent = Path(self._tmp.name)
+        self.uploads = self.parent / "uploads"
+        self.uploads.mkdir()
+        (self.uploads / "a.txt").write_text("hola", encoding="utf-8")
+        (self.uploads / "sub").mkdir()
+        (self.parent / "secreto.txt").write_text("secreto", encoding="utf-8")
+        patcher = patch("app.config.UPLOAD_DIR", self.uploads)
+        patcher.start()
+        self.addCleanup(patcher.stop)
+
+    def test_existing_file(self):
+        self.assertEqual(handle("/attachments/a.txt"), (200, "hola"))
+
+    def test_missing_file(self):
+        self.assertEqual(handle("/attachments/no.txt"), (404, "not found"))
+
+    def test_directory_inside_uploads(self):
+        self.assertEqual(handle("/attachments/sub"), (404, "not found"))
+
+    def test_uploads_folder_itself(self):
+        self.assertEqual(handle("/attachments/"), (404, "not found"))
+        self.assertEqual(handle("/attachments/."), (404, "not found"))
+        self.assertEqual(handle("/attachments/%2e"), (404, "not found"))
+
+    def test_traversal_cannot_leave_uploads(self):
+        for path in (
+            "/attachments/..",
+            "/attachments/%2e%2e",
+            "/attachments/..%2Fsecreto.txt",
+            "/attachments/%2e%2e%2fsecreto.txt",
+            "/attachments/..%5Csecreto.txt",
+            "/attachments/%2Fetc%2Fpasswd",
+            "/attachments/" + quote(str(self.parent / "secreto.txt"), safe=""),
+            "/attachments/" + str(self.parent / "secreto.txt"),
+            "/attachments/%00a.txt",
+            "/attachments/C:secreto.txt",
+        ):
+            with self.subTest(path=path):
+                self.assertEqual(handle(path), (404, "not found"))
+
+    def test_double_encoding_is_a_literal_name(self):
+        # %25 se decodifica una vez: el nombre es el literal "%2e%2e%2f..." y no existe.
+        self.assertEqual(
+            handle("/attachments/%252e%252e%252fsecreto.txt"), (404, "not found")
+        )
+
+    @unittest.skipUnless(hasattr(os, "symlink"), "sin soporte de enlaces simbólicos")
+    def test_symlink_pointing_outside_is_rejected(self):
+        try:
+            os.symlink(self.parent / "secreto.txt", self.uploads / "enlace.txt")
+        except OSError:
+            self.skipTest("el entorno no permite crear enlaces simbólicos")
+        self.assertEqual(handle("/attachments/enlace.txt"), (404, "not found"))
