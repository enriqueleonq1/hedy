+def attachment(name):
+    base = config.UPLOAD_DIR.resolve()
+    try:
+        target = (base / name).resolve()
+    except ValueError:  # p. ej. un NUL en el nombre
+        return 404, "not found"
+    # Solo archivos directamente dentro de la carpeta: rechaza "..", rutas
+    # absolutas, subcarpetas, la propia carpeta y enlaces que salen de ella.
+    if target.parent != base or not target.is_file():
+        return 404, "not found"
+    return 200, target.read_text()
+
