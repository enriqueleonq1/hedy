@@ -1,5 +1,10 @@
+import os
+import tempfile
 import unittest
+from pathlib import Path
+from unittest import mock
 
+from app import config
 from app.routes import handle
 
 
@@ -11,3 +16,61 @@ class RoutesTest(unittest.TestCase):
         self.assertEqual(handle("/invoices/1001"), (200, "Acme: 120.00"))
         self.assertEqual(handle("/invoices/10%30%31"), (200, "Acme: 120.00"))
         self.assertEqual(handle("/invoices/9"), (404, "not found"))
+
+
+class AttachmentsTest(unittest.TestCase):
+    def setUp(self):
+        self._tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self._tmp.cleanup)
+        root = Path(self._tmp.name)
+        self.uploads = root / "uploads"
+        self.uploads.mkdir()
+        (self.uploads / "a.txt").write_text("hola")
+        (self.uploads / "sub").mkdir()
+        (self.uploads / "sub" / "b.txt").write_text("sub")
+        (root / "secret.txt").write_text("secreto")
+        patcher = mock.patch.object(config, "UPLOAD_DIR", self.uploads)
+        patcher.start()
+        self.addCleanup(patcher.stop)
+
+    def test_serves_file_in_upload_dir(self):
+        self.assertEqual(handle("/attachments/a.txt"), (200, "hola"))
+
+    def test_missing_file(self):
+        self.assertEqual(handle("/attachments/nope.txt"), (404, "not found"))
+
+    def test_upload_dir_itself_is_not_served(self):
+        self.assertEqual(handle("/attachments/"), (404, "not found"))
+        self.assertEqual(handle("/attachments/."), (404, "not found"))
+
+    def test_subdirectory_is_not_served(self):
+        self.assertEqual(handle("/attachments/sub"), (404, "not found"))
+
+    def test_parent_traversal_is_rejected(self):
+        self.assertEqual(handle("/attachments/../secret.txt"), (404, "not found"))
+        self.assertEqual(handle("/attachments/..%2fsecret.txt"), (404, "not found"))
+        self.assertEqual(handle("/attachments/%2e%2e%2fsecret.txt"), (404, "not found"))
+        self.assertEqual(handle("/attachments/%2e%2e/secret.txt"), (404, "not found"))
+
+    def test_absolute_path_is_rejected(self):
+        secret = str(self.uploads.parent / "secret.txt")
+        self.assertEqual(handle("/attachments/" + secret), (404, "not found"))
+        self.assertEqual(handle("/attachments/" + secret.replace("/", "%2f")), (404, "not found"))
+
+    def test_nested_path_is_rejected(self):
+        self.assertEqual(handle("/attachments/sub/b.txt"), (404, "not found"))
+
+    def test_symlink_leaving_upload_dir_is_rejected(self):
+        link = self.uploads / "link.txt"
+        try:
+            os.symlink(self.uploads.parent / "secret.txt", link)
+        except (OSError, NotImplementedError):
+            self.skipTest("symlinks no disponibles")
+        self.assertEqual(handle("/attachments/link.txt"), (404, "not found"))
+
+    def test_nul_byte_is_not_found(self):
+        self.assertEqual(handle("/attachments/a.txt%00"), (404, "not found"))
+
+
+if __name__ == "__main__":
+    unittest.main()
