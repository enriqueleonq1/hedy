diff --git a/tests/test_inventory.py b/tests/test_inventory.py
index 49f19d0..94bb730 100644
--- a/tests/test_inventory.py
+++ b/tests/test_inventory.py
@@ -1,6 +1,6 @@
 import unittest
 
-from shop.errors import NotEnoughStock
+from shop.errors import NotEnoughStock, ReservationExpired
 from shop.inventory import Inventory
 from shop.report import pending_report
 
@@ -34,3 +34,48 @@ class InventoryTest(unittest.TestCase):
     def test_report(self):
         self.inv.reserve("A1", 1)
         self.assertEqual(pending_report(self.inv), "#1 Lámpara x1")
+
+    def test_reservation_is_active_before_ttl(self):
+        r = self.inv.reserve("A1", 3)
+        self.clock.now += Inventory.RESERVATION_TTL - 1
+        self.assertEqual(self.inv.available("A1"), 2)
+        self.assertEqual(self.inv.release_expired(), 0)
+        self.inv.confirm(r.id)
+        self.assertEqual(self.inv.product("A1").stock, 2)
+
+    def test_expired_reservation_returns_stock(self):
+        self.inv.reserve("A1", 3)
+        self.clock.now += Inventory.RESERVATION_TTL
+        self.assertEqual(self.inv.available("A1"), 5)
+        self.assertEqual(self.inv.release_expired(), 1)
+        self.assertEqual(self.inv.release_expired(), 0)
+        self.assertEqual(self.inv.available("A1"), 5)
+
+    def test_confirmed_reservation_never_expires(self):
+        r = self.inv.reserve("A1", 2)
+        self.inv.confirm(r.id)
+        self.clock.now += 10 * Inventory.RESERVATION_TTL
+        self.assertEqual(self.inv.release_expired(), 0)
+        self.inv.confirm(r.id)
+        self.assertEqual(self.inv.product("A1").stock, 3)
+
+    def test_confirm_expired_reservation_fails(self):
+        r = self.inv.reserve("A1", 2)
+        self.clock.now += Inventory.RESERVATION_TTL
+        with self.assertRaises(ReservationExpired):
+            self.inv.confirm(r.id)
+        self.assertEqual(self.inv.product("A1").stock, 5)
+
+    def test_confirm_released_reservation_fails(self):
+        r = self.inv.reserve("A1", 2)
+        self.clock.now += Inventory.RESERVATION_TTL
+        self.inv.release_expired()
+        with self.assertRaises(ReservationExpired):
+            self.inv.confirm(r.id)
+
+    def test_report_hides_expired(self):
+        self.inv.reserve("A1", 1)
+        self.clock.now += Inventory.RESERVATION_TTL - 300
+        self.inv.reserve("A1", 2)
+        self.clock.now += 300
+        self.assertEqual(pending_report(self.inv), "#2 Lámpara x2")
