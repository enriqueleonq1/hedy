 from .invoices import find_invoice
 
 
@@ -20,9 +21,19 @@ def invoice(invoice_id):
     return 200, f"{found['customer']}: {found['total']}"
 
 
+def attachment(name):
+    base = UPLOAD_DIR.resolve()
+    target = (base / name).resolve()
+    # Resolving first rejects "..", absolute names and symlinks leaving the folder.
+    if base not in target.parents or not target.is_file():
+        return 404, "not found"
+    return 200, target.read_text(encoding="utf-8")
+
+
 ROUTES = {
     "/health": health,
     "/invoices/": invoice,
+    "/attachments/": attachment,
 }
 
 
