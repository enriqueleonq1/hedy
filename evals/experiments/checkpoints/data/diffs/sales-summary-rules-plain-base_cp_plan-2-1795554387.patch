@@ -0,0 +1,25 @@
+import unittest
+from decimal import Decimal
+
+from reports.summary import monthly_summary
+
+
+class MonthlySummaryTest(unittest.TestCase):
+    def test_adds_only_the_month(self):
+        sales = [
+            {"date": "2025-03-01", "amount": "10.10"},
+            {"date": "2025-03-28", "amount": "4.90"},
+            {"date": "2025-04-01", "amount": "5"},
+        ]
+        with self.assertLogs("reports.summary", level="INFO"):
+            self.assertEqual(monthly_summary(sales, "2025-03"), Decimal("15.00"))
+
+    def test_month_without_sales_is_zero(self):
+        sales = [{"date": "2025-03-01", "amount": "10.10"}]
+        with self.assertLogs("reports.summary", level="INFO"):
+            self.assertEqual(monthly_summary(sales, "2025-05"), Decimal("0"))
+
+    def test_decimal_amounts_are_exact(self):
+        sales = [{"date": "2025-03-01", "amount": "0.1"}, {"date": "2025-03-02", "amount": "0.2"}]
+        with self.assertLogs("reports.summary", level="INFO"):
+            self.assertEqual(monthly_summary(sales, "2025-03"), Decimal("0.3"))
