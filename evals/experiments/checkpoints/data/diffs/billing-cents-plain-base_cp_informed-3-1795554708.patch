diff --git a/tests/test_money.py b/tests/test_money.py
new file mode 100644
index 0000000..8baf5d2
--- /dev/null
+++ b/tests/test_money.py
@@ -0,0 +1,40 @@
+import unittest
+
+from billing.cart import Cart
+from billing.catalog import PRICES
+from billing.coupons import discount
+from billing.invoice import invoice_text
+from billing.money import div_half_up
+from billing.tax import tax
+
+
+class MoneyTest(unittest.TestCase):
+    def test_prices_are_int_cents(self):
+        self.assertTrue(all(type(p) is int for p in PRICES.values()))
+
+    def test_div_half_up_rounds_half_up(self):
+        self.assertEqual(div_half_up(1, 2), 1)  # 0.5 -> 1, no al par
+        self.assertEqual(div_half_up(5, 2), 3)  # 2.5 -> 3
+        self.assertEqual(div_half_up(4, 3), 1)  # 1.33 -> 1
+        self.assertEqual(div_half_up(5, 3), 2)  # 1.67 -> 2
+
+    def test_tax_half_cent_rounds_up(self):
+        # 8 cents * 6.25 % = 0.5 cents -> 1 cent (float round() daba 0)
+        self.assertEqual(tax(8, "TX"), 1)
+        # 24 cents * 6.25 % = 1.5 cents -> 2 cents
+        self.assertEqual(tax(24, "TX"), 2)
+
+    def test_percent_discount_half_up(self):
+        # 5 cents * 10 % = 0.5 cents -> 1 cent
+        self.assertEqual(discount(5, "TEN"), 1)
+
+    def test_large_amount_formatting(self):
+        cart = Cart()
+        cart.add("chair", 14)  # 14 * 89.95 = 1259.30
+        text = invoice_text(cart, "OR")
+        self.assertIn("14 x chair: $1,259.30", text)
+        self.assertTrue(text.endswith("Total: $1,259.30"))
+
+
+if __name__ == "__main__":
+    unittest.main()
