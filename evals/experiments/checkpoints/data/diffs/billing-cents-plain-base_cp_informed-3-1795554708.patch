--- /dev/null
+++ b/billing/money.py
@@ -0,0 +1,9 @@
+# Todo el dinero de billing/ se maneja en centavos (int).
+
+
+def div_half_up(num, den):
+    """num / den redondeado al entero más cercano, con la mitad hacia arriba.
+
+    Solo para num >= 0 y den > 0.
+    """
+    return (2 * num + den) // (2 * den)
