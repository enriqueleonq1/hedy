+
+def format_price(product: Product) -> str:
+    cents_value = product.price_cents
+    if type(cents_value) is not int:
+        raise TypeError("price_cents debe ser int")
+    if cents_value < 0:
+        raise ValueError("price_cents no puede ser negativo")
+    dollars, cents = divmod(cents_value, 100)
+    return f"{CURRENCY_CODE} {dollars:,}.{cents:02d}"
