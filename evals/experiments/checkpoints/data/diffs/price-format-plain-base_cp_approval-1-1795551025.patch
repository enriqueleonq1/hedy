@@ -0,0 +1,38 @@
+import unittest
+
+from shop.catalog import CATALOG, Product, format_price
+
+
+class FormatPriceTest(unittest.TestCase):
+    def test_formats_cents_with_currency_prefix_and_two_decimals(self):
+        self.assertEqual(format_price(Product("x", 1250)), "USD 12.50")
+        self.assertEqual(format_price(Product("x", 900)), "USD 9.00")
+
+    def test_zero_is_shown_with_two_decimals(self):
+        self.assertEqual(format_price(Product("x", 0)), "USD 0.00")
+
+    def test_thousands_are_separated_by_commas(self):
+        self.assertEqual(format_price(Product("x", 100000)), "USD 1,000.00")
+
+    def test_catalog_products_are_formatted(self):
+        for product in CATALOG:
+            with self.subTest(product=product.name):
+                self.assertTrue(format_price(product).startswith("USD "))
+
+    def test_rejects_negative_amounts(self):
+        with self.assertRaises(ValueError):
+            format_price(Product("x", -1))
+
+    def test_rejects_non_integer_amounts(self):
+        for value in (12.5, "1250", None):
+            with self.subTest(value=value):
+                with self.assertRaises(TypeError):
+                    format_price(Product("x", value))
+
+    def test_rejects_bool_amounts(self):
+        with self.assertRaises(TypeError):
+            format_price(Product("x", True))
+
+
+if __name__ == "__main__":
+    unittest.main()
