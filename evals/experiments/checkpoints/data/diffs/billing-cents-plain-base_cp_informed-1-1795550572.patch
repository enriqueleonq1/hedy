diff --git a/tests/test_rounding.py b/tests/test_rounding.py
new file mode 100644
index 0000000..89317d0
--- /dev/null
+++ b/tests/test_rounding.py
@@ -0,0 +1,20 @@
+import unittest
+
+from billing.coupons import discount
+from billing.invoice import money
+from billing.tax import tax
+
+
+class RoundingTest(unittest.TestCase):
+    def test_tax_rounds_half_up(self):
+        # 8 cents at 6.25% is exactly 0.5 cents: half up gives 1, not banker's 0.
+        self.assertEqual(tax(8, "TX"), 1)
+
+    def test_percent_discount_rounds_half_up(self):
+        # 10% of 5 cents is exactly 0.5 cents: half up gives 1.
+        self.assertEqual(discount(5, "TEN"), 1)
+
+    def test_money_formats_cents(self):
+        self.assertEqual(money(0), "$0.00")
+        self.assertEqual(money(5), "$0.05")
+        self.assertEqual(money(123456), "$1,234.56")
