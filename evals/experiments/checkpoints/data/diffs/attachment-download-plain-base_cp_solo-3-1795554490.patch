+def attachment(name):
+    base = config.UPLOAD_DIR.resolve()
+    path = (base / name).resolve()
+    # Solo archivos directamente dentro de UPLOAD_DIR: impide `..` y subcarpetas.
+    if path.parent != base or not path.is_file():
+        return 404, "not found"
+    return 200, path.read_text()
+
