+class CentsTest(unittest.TestCase):
+    def test_catalog_prices_are_int_cents(self):
+        for sku, value in PRICES.items():
+            self.assertIs(type(value), int, sku)
+        self.assertEqual(PRICES["pen"], 115)
+        self.assertEqual(PRICES["chair"], 8995)
+
+    def test_tax_rounds_half_up(self):
+        # 1200 * 8.875 % = 106.5 centavos -> 107 (half-up, no half-even)
+        self.assertEqual(tax(1200, "NY"), 107)
+        self.assertEqual(tax(1200, "TX"), 75)
+        self.assertEqual(tax(1200, "OR"), 0)
+        self.assertIs(type(tax(1200, "NY")), int)
+
+    def test_percent_coupon_rounds_half_up(self):
+        # 1199 * 50 % = 599.5 -> 600
+        self.assertEqual(discount(1199, "HALF"), 600)
+        # 1005 * 10 % = 100.5 -> 101
+        self.assertEqual(discount(1005, "TEN"), 101)
+        self.assertIs(type(discount(1199, "HALF")), int)
+
+    def test_fixed_coupon_is_capped_at_subtotal(self):
+        self.assertEqual(discount(500, "SAVE5"), 500)
+        self.assertEqual(discount(3998, "BIG"), 3998)
+        self.assertEqual(discount(20000, "BIG"), 10000)
+        self.assertEqual(discount(3998, None), 0)
+        self.assertIs(type(discount(3998, None)), int)
+
