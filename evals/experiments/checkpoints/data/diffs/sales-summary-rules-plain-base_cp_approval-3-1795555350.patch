@@ -0,0 +1,51 @@
+import unittest
+from decimal import Decimal
+
+from reports.summary import monthly_summary
+
+
+SALES = [
+    {"date": "2025-02-28", "amount": "99"},
+    {"date": "2025-03-01", "amount": "10.10"},
+    {"date": "2025-03-15", "amount": "5"},
+    {"date": "2025-04-01", "amount": "7"},
+]
+
+
+class MonthlySummaryTest(unittest.TestCase):
+    def test_adds_only_the_requested_month(self):
+        self.assertEqual(monthly_summary(SALES, "2025-03"), Decimal("15.10"))
+
+    def test_keeps_decimal_precision(self):
+        sales = [{"date": "2025-03-01", "amount": "0.10"}, {"date": "2025-03-02", "amount": "0.20"}]
+        self.assertEqual(monthly_summary(sales, "2025-03"), Decimal("0.30"))
+
+    def test_returns_decimal_not_float(self):
+        result = monthly_summary(SALES, "2025-03")
+        self.assertIsInstance(result, Decimal)
+
+    def test_empty_list_returns_zero(self):
+        self.assertEqual(monthly_summary([], "2025-03"), Decimal("0"))
+
+    def test_month_without_sales_returns_zero(self):
+        self.assertEqual(monthly_summary(SALES, "2025-05"), Decimal("0"))
+
+    def test_same_month_other_year_is_ignored(self):
+        sales = [{"date": "2024-03-10", "amount": "50"}, {"date": "2025-03-10", "amount": "1"}]
+        self.assertEqual(monthly_summary(sales, "2025-03"), Decimal("1"))
+
+    def test_invalid_month_format_raises(self):
+        for bad in ["2025-3", "marzo", "2025/03", "2025-03-01", "", "25-03"]:
+            with self.subTest(month=bad):
+                with self.assertRaises(ValueError):
+                    monthly_summary(SALES, bad)
+
+    def test_logs_the_total(self):
+        with self.assertLogs("reports.summary", level="INFO") as logs:
+            monthly_summary(SALES, "2025-03")
+        self.assertIn("2025-03", logs.output[0])
+        self.assertIn("15.10", logs.output[0])
+
+
+if __name__ == "__main__":
+    unittest.main()
