+"""Resumen mensual de ventas."""
+
+import logging
+import re
+from decimal import Decimal
+
+logger = logging.getLogger(__name__)
+
+
+def monthly_summary(sales, month):
+    """Lo vendido en `month` ('AAAA-MM')."""
+    if not re.fullmatch(r"\d{4}-\d{2}", month):
+        raise ValueError(f"Mes inválido, se esperaba 'AAAA-MM': {month!r}")
+    total = sum((Decimal(str(s["amount"])) for s in sales if s["date"][:7] == month), Decimal("0"))
+    logger.info("Ventas de %s: %s", month, total)
+    return total
