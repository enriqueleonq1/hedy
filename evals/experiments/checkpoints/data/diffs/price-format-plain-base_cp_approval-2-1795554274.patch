+import unittest
+
+from shop.catalog import CATALOG, Product, format_price
+
+
+class FormatPriceTests(unittest.TestCase):
+    def test_formats_catalog_items_for_display(self):
+        self.assertEqual(format_price(CATALOG[0]), "USD 12.50")
+        self.assertEqual(format_price(CATALOG[1]), "USD 9.00")
+
+    def test_zero_has_two_decimals(self):
+        self.assertEqual(format_price(Product("x", 0)), "USD 0.00")
+
+    def test_single_cent_is_padded(self):
+        self.assertEqual(format_price(Product("x", 5)), "USD 0.05")
+
+    def test_whole_units_keep_two_decimals(self):
+        self.assertEqual(format_price(Product("x", 100)), "USD 1.00")
+
+    def test_large_amounts_use_integer_math(self):
+        self.assertEqual(format_price(Product("x", 123456)), "USD 1234.56")
+
+    def test_negative_price_is_rejected(self):
+        with self.assertRaises(ValueError):
+            format_price(Product("x", -1))
+
+    def test_returns_str(self):
+        self.assertIsInstance(format_price(CATALOG[0]), str)
+
+
+if __name__ == "__main__":
+    unittest.main()
