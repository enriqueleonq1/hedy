+class AttachmentsTest(unittest.TestCase):
+    def setUp(self):
+        self._tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self._tmp.cleanup)
+        base = Path(self._tmp.name)
+        # La carpeta de subidas y, fuera de ella, un "secreto" que no debe leerse.
+        self.upload_dir = base / "uploads"
+        self.upload_dir.mkdir()
+        self.secret = base / "secreto.txt"
+        self.secret.write_bytes(b"clave-secreta")
+        (self.upload_dir / "a.txt").write_bytes(b"hola adjunto")
+        (self.upload_dir / "sub").mkdir()
+        (self.upload_dir / "sub" / "b.txt").write_bytes(b"sub")
+        (self.upload_dir / "carpeta").mkdir()
+
+        patcher = mock.patch("app.config.UPLOAD_DIR", self.upload_dir)
+        patcher.start()
+        self.addCleanup(patcher.stop)
+
+    def test_existing_file_returns_content(self):
+        self.assertEqual(handle("/attachments/a.txt"), (200, b"hola adjunto"))
+
+    def test_missing_file_returns_404(self):
+        self.assertEqual(handle("/attachments/nope.txt"), (404, "not found"))
+
+    def test_empty_name_returns_404(self):
+        self.assertEqual(handle("/attachments/"), (404, "not found"))
+
+    def test_dot_names_return_404(self):
+        self.assertEqual(handle("/attachments/."), (404, "not found"))
+        self.assertEqual(handle("/attachments/.."), (404, "not found"))
+        self.assertEqual(handle("/attachments/%2e"), (404, "not found"))
+        self.assertEqual(handle("/attachments/%2e%2e"), (404, "not found"))
+
+    def test_traversal_returns_404(self):
+        for raw in (
+            "/attachments/..%2Fsecreto.txt",
+            "/attachments/%2e%2e%2Fsecreto.txt",
+            "/attachments/%2e%2e%2fsecreto.txt",
+            "/attachments/..%5Csecreto.txt",
+            "/attachments/..%5csecreto.txt",
+            "/attachments/..%2F..%2Fsecreto.txt",
+        ):
+            with self.subTest(raw=raw):
+                self.assertEqual(handle(raw), (404, "not found"))
+
+    def test_absolute_path_returns_404(self):
+        raw = "/attachments/%2F" + str(self.secret).lstrip("/")
+        self.assertEqual(handle(raw), (404, "not found"))
+        self.assertEqual(handle("/attachments/" + str(self.secret)), (404, "not found"))
+
+    def test_nul_returns_404(self):
+        self.assertEqual(handle("/attachments/a.txt%00"), (404, "not found"))
+        self.assertEqual(handle("/attachments/a.txt%00.png"), (404, "not found"))
+
+    def test_subpath_returns_404(self):
+        self.assertEqual(handle("/attachments/sub%2Fb.txt"), (404, "not found"))
+        self.assertEqual(handle("/attachments/sub/b.txt"), (404, "not found"))
+
+    def test_directory_returns_404(self):
+        self.assertEqual(handle("/attachments/carpeta"), (404, "not found"))
+        self.assertEqual(handle("/attachments/sub"), (404, "not found"))
+
+    def test_missing_upload_dir_returns_404(self):
+        with mock.patch("app.config.UPLOAD_DIR", self.upload_dir.parent / "no-existe"):
+            self.assertEqual(handle("/attachments/a.txt"), (404, "not found"))
+
+    @unittest.skipIf(os.name == "nt", "symlinks requieren permisos en Windows")
+    def test_symlink_pointing_outside_returns_404(self):
+        link = self.upload_dir / "enlace.txt"
+        os.symlink(self.secret, link)
+        self.assertEqual(handle("/attachments/enlace.txt"), (404, "not found"))
+
+    def test_bad_utf8_content_is_served_as_bytes(self):
+        (self.upload_dir / "img.bin").write_bytes(b"\xff\xd8\xff\x00")
+        self.assertEqual(handle("/attachments/img.bin"), (200, b"\xff\xd8\xff\x00"))
+
+    def test_bare_route_without_slash_is_404(self):
+        self.assertEqual(handle("/attachments"), (404, "not found"))
+
+
+if __name__ == "__main__":
+    unittest.main()
