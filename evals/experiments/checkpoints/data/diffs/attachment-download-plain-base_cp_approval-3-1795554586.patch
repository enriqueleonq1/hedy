     return 200, f"{found['customer']}: {found['total']}"
 
 
+def attachment(name):
+    # El nombre lo escribe el cliente: nada que apunte fuera de UPLOAD_DIR.
+    # `name` ya viene decodificado, así que %2e, %2f y %5c llegan como . / \.
+    if name in ("", ".", "..") or any(c in name for c in "/\\\x00"):
+        return 404, "not found"
+    base = config.UPLOAD_DIR.resolve()
+    candidate = (config.UPLOAD_DIR / name).resolve()
+    try:
+        candidate.relative_to(base)  # symlinks que salen de la carpeta
+    except ValueError:
+        return 404, "not found"
+    if not candidate.is_file():  # carpetas, inexistentes, uploads/ ausente
+        return 404, "not found"
+    return 200, candidate.read_bytes()
+
+
 ROUTES = {
     "/health": health,
     "/invoices/": invoice,
+    "/attachments/": attachment,
 }
 
 
