     "TEN": ("percent", 10),
-    "SAVE5": ("fixed", 5.0),
+    "SAVE5": ("fixed", 500),
     "HALF": ("percent", 50),
-    "BIG": ("fixed", 100.0),
+    "BIG": ("fixed", 10000),
 }
 
 
 def discount(subtotal, code):
+    # Amounts in cents, rounded to the nearest cent, half up.
     if code is None:
