+    def test_ny_tax_rounds_to_cent(self):
+        cart = Cart()
+        cart.add("lamp")
+        # 1999 * 8.875 % = 177.41 cents -> 177
+        self.assertEqual(tax(1999, "NY"), 177)
+        self.assertIn("Impuesto: $1.77", invoice_text(cart, "NY"))
