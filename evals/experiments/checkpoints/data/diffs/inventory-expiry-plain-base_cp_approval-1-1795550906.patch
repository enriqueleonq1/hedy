+
+    def test_reservation_expires_at_fifteen_minutes(self):
+        self.inv.reserve("A1", 3)
+        self.clock.now += 899
+        self.assertEqual(self.inv.available("A1"), 2)
+        self.clock.now += 1  # exactly 900 s
+        self.assertEqual(self.inv.available("A1"), 5)
+
+    def test_release_expired_returns_count_once(self):
+        self.inv.reserve("A1", 3)
+        self.clock.now += 900
+        self.assertEqual(self.inv.release_expired(), 1)
+        self.assertEqual(self.inv.release_expired(), 0)
+        self.assertEqual(self.inv.available("A1"), 5)
+
+    def test_release_expired_ignores_live_reservations(self):
+        self.inv.reserve("A1", 1)
+        self.clock.now += 899
+        self.assertEqual(self.inv.release_expired(), 0)
+
+    def test_confirm_expired_fails_without_taking_stock(self):
+        r = self.inv.reserve("A1", 2)
+        self.clock.now += 900
+        with self.assertRaises(ReservationExpired):
+            self.inv.confirm(r.id)
+        self.assertEqual(self.inv.product("A1").stock, 5)
+        self.assertEqual(self.inv.available("A1"), 5)
+
+    def test_confirm_expired_fails_after_release_expired(self):
+        r = self.inv.reserve("A1", 2)
+        self.clock.now += 900
+        self.inv.release_expired()
+        with self.assertRaises(ReservationExpired):
+            self.inv.confirm(r.id)
+        self.assertEqual(self.inv.product("A1").stock, 5)
+
+    def test_confirm_at_899_seconds_still_works(self):
+        r = self.inv.reserve("A1", 2)
+        self.clock.now += 899
+        self.inv.confirm(r.id)
+        self.assertEqual(self.inv.product("A1").stock, 3)
+
+    def test_confirmed_reservation_never_expires(self):
+        r = self.inv.reserve("A1", 2)
+        self.inv.confirm(r.id)
+        self.clock.now += 1000
+        self.assertEqual(self.inv.available("A1"), 3)
+        self.assertEqual(self.inv.release_expired(), 0)
+        self.inv.confirm(r.id)  # idempotent, must not raise
+        self.assertEqual(self.inv.product("A1").stock, 3)
+
+    def test_report_hides_expired_but_shows_live(self):
