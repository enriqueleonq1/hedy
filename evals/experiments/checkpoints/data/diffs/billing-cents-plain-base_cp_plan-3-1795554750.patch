 import unittest
 
 from billing.cart import Cart
+from billing.coupons import discount
 from billing.invoice import invoice_text
+from billing.tax import tax
+
+
+class RoundingTest(unittest.TestCase):
+    def test_tax_rounds_half_up_to_the_cent(self):
+        # 1200 * 8.875 % = 106.5 cents -> 107
+        self.assertEqual(tax(1200, "NY"), 107)
+
+    def test_percent_coupon_rounds_half_up_to_the_cent(self):
+        # 10 % of 125 cents = 12.5 cents -> 13
+        self.assertEqual(discount(125, "TEN"), 13)
+
+    def test_thousands_are_grouped(self):
+        cart = Cart()
+        cart.add("chair", 12)
+        self.assertEqual(
+            invoice_text(cart, "OR"),
+            "12 x chair: $1,079.40\nSubtotal: $1,079.40\nImpuesto: $0.00\nTotal: $1,079.40",
+        )
 
 
