+import unittest
+from decimal import Decimal
+
+from reports.summary import monthly_summary
+
+
+class MonthlySummaryTest(unittest.TestCase):
+    def test_adds_only_the_month(self):
+        sales = [
+            {"date": "2025-03-01", "amount": "10.10"},
+            {"date": "2025-03-20", "amount": "5"},
+            {"date": "2025-04-01", "amount": "100"},
+        ]
+        self.assertEqual(monthly_summary(sales, "2025-03"), Decimal("15.10"))
+
+    def test_does_not_mix_years(self):
+        sales = [
+            {"date": "2025-12-05", "amount": "7"},
+            {"date": "2026-12-05", "amount": "99"},
+        ]
+        self.assertEqual(monthly_summary(sales, "2025-12"), Decimal("7"))
+
+    def test_month_without_sales_is_zero(self):
+        sales = [{"date": "2025-03-01", "amount": "10"}]
+        self.assertEqual(monthly_summary(sales, "2025-05"), Decimal("0"))
+
+    def test_empty_list_is_zero(self):
+        self.assertEqual(monthly_summary([], "2025-03"), Decimal("0"))
+
+    def test_rejects_malformed_month(self):
+        for month in ["2025-3", "marzo", "2025-13", "2025-00", "2025-03-01"]:
+            with self.subTest(month=month):
+                with self.assertRaises(ValueError):
+                    monthly_summary([], month)
+
+    def test_logs_the_total(self):
+        sales = [{"date": "2025-03-01", "amount": "10.10"}]
+        with self.assertLogs("reports.summary", level="INFO") as logs:
+            monthly_summary(sales, "2025-03")
+        self.assertIn("10.10", "\n".join(logs.output))
+
+
+if __name__ == "__main__":
+    unittest.main()
