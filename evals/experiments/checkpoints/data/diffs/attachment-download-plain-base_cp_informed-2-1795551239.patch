diff --git a/tests/test_routes.py b/tests/test_routes.py
index 6dba1d9..3a9d892 100644
--- a/tests/test_routes.py
+++ b/tests/test_routes.py
@@ -1,8 +1,64 @@
+import os
+import tempfile
 import unittest
+from pathlib import Path
+from unittest import mock
 
 from app.routes import handle
 
 
+class AttachmentsTest(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        root = Path(self.tmp.name)
+        self.uploads = root / "uploads"
+        self.uploads.mkdir()
+        (self.uploads / "a.txt").write_text("hola", encoding="utf-8")
+        (self.uploads / "sub").mkdir()
+        self.secret = root / "secret.txt"
+        self.secret.write_text("secreto", encoding="utf-8")
+        os.symlink(self.secret, self.uploads / "link.txt")
+        patcher = mock.patch("app.routes.UPLOAD_DIR", self.uploads)
+        patcher.start()
+        self.addCleanup(patcher.stop)
+        self.addCleanup(self.tmp.cleanup)
+
+    def test_serves_existing_file(self):
+        self.assertEqual(handle("/attachments/a.txt"), (200, "hola"))
+
+    def test_missing_file(self):
+        self.assertEqual(handle("/attachments/nope.txt"), (404, "not found"))
+
+    def test_traversal_is_rejected(self):
+        for raw in (
+            "/attachments/../secret.txt",
+            "/attachments/%2e%2e/secret.txt",
+            "/attachments/%2e%2e%2fsecret.txt",
+            "/attachments/..%2fsecret.txt",
+            "/attachments/..%5csecret.txt",
+            "/attachments/%2e%2e",
+            "/attachments/.",
+            "/attachments/link.txt",
+        ):
+            with self.subTest(raw=raw):
+                self.assertEqual(handle(raw), (404, "not found"))
+
+    def test_absolute_path_is_rejected(self):
+        absolute = str(self.secret)
+        self.assertEqual(handle("/attachments/" + absolute), (404, "not found"))
+        self.assertEqual(
+            handle("/attachments/" + absolute.replace("/", "%2f")),
+            (404, "not found"),
+        )
+
+    def test_null_byte_is_rejected(self):
+        self.assertEqual(handle("/attachments/a.txt%00"), (404, "not found"))
+
+    def test_directories_are_not_served(self):
+        self.assertEqual(handle("/attachments/sub"), (404, "not found"))
+        self.assertEqual(handle("/attachments/"), (404, "not found"))
+
+
 class RoutesTest(unittest.TestCase):
     def test_health(self):
         self.assertEqual(handle("/health"), (200, "ok"))
