+def attachment(name):
+    # Un solo componente de nombre: nada vacío, ni separadores, ni NUL.
+    if not name or "/" in name or "\\" in name or "\0" in name:
+        return 404, "not found"
+    base = UPLOAD_DIR.resolve()
+    # resolve() sigue symlinks y normaliza "..", así que la comprobación
+    # de contención cubre también rutas absolutas y enlaces que salen.
+    path = (base / name).resolve()
+    if not path.is_relative_to(base) or path == base or not path.is_file():
+        return 404, "not found"
+    return 200, path.read_text(encoding="utf-8")
+
+
