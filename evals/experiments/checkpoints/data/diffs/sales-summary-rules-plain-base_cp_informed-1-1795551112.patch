+import unittest
+from decimal import Decimal
+
+from reports.summary import monthly_summary
+
+
+class MonthlySummaryTest(unittest.TestCase):
+    def test_adds_the_month(self):
+        sales = [
+            {"date": "2025-03-01", "amount": "10.10"},
+            {"date": "2025-03-31", "amount": "0.20"},
+            {"date": "2025-04-01", "amount": "5"},
+        ]
+        self.assertEqual(monthly_summary(sales, "2025-03"), Decimal("10.30"))
+
+    def test_empty_month_is_zero(self):
+        sales = [{"date": "2025-03-01", "amount": "10.10"}]
+        self.assertEqual(monthly_summary(sales, "2025-05"), Decimal("0"))
