+import unittest
+from decimal import Decimal
+
+from reports.summary import monthly_summary
+
+
+class MonthlySummaryTest(unittest.TestCase):
+    def test_adds_only_the_month(self):
+        sales = [
+            {"date": "2025-03-01", "amount": "10.10"},
+            {"date": "2025-03-31", "amount": "5"},
+            {"date": "2025-04-01", "amount": "100"},
+        ]
+        self.assertEqual(monthly_summary(sales, "2025-03"), Decimal("15.10"))
+
+    def test_month_without_sales_is_zero(self):
+        sales = [{"date": "2025-03-01", "amount": "10"}]
+        self.assertEqual(monthly_summary(sales, "2025-05"), Decimal("0"))
+
+    def test_logs_the_total(self):
+        sales = [{"date": "2025-03-01", "amount": "10.10"}, {"date": "2025-03-02", "amount": "5"}]
+        with self.assertLogs("reports.summary", level="INFO") as logs:
+            monthly_summary(sales, "2025-03")
+        self.assertEqual(logs.output, ["INFO:reports.summary:Ventas de 2025-03: 15.10"])
