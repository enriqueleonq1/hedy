     return 200, f"{found['customer']}: {found['total']}"
 
 
+def attachment(name):
+    # `name` ya viene decodificado: %2e%2e%2f llega como "../".
+    if name in ("", ".", "..") or "/" in name or "\\" in name or "\x00" in name:
+        return 404, "not found"
+    base = config.UPLOAD_DIR.resolve()
+    candidate = (base / name).resolve()
+    # Un symlink dentro de la carpeta que apunte fuera no se sigue.
+    if not candidate.is_relative_to(base) or not candidate.is_file():
+        return 404, "not found"
+    return 200, candidate.read_text(encoding="utf-8")
+
+
 ROUTES = {
     "/health": health,
     "/invoices/": invoice,
+    "/attachments/": attachment,
 }
 
 
