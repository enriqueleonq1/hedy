+
+    def test_attachment(self):
+        with tempfile.TemporaryDirectory() as uploads, tempfile.TemporaryDirectory() as outside:
+            Path(uploads, "a.txt").write_text("hola", encoding="utf-8")
+            Path(uploads, "subdir").mkdir()
+            secret = Path(outside, "secret.txt")
+            secret.write_text("secreto", encoding="utf-8")
+            with mock.patch.object(config, "UPLOAD_DIR", Path(uploads)):
+                # Caso feliz y archivo inexistente.
+                self.assertEqual(handle("/attachments/a.txt"), (200, "hola"))
+                self.assertEqual(handle("/attachments/nope.txt"), (404, "not found"))
+
+                # La carpeta en sí no se sirve.
+                self.assertEqual(handle("/attachments/"), (404, "not found"))
+                self.assertEqual(handle("/attachments/."), (404, "not found"))
+                self.assertEqual(handle("/attachments/.."), (404, "not found"))
+                self.assertEqual(handle("/attachments/subdir"), (404, "not found"))
+
+                # Salir de la carpeta con .., ruta absoluta o nombres codificados.
+                self.assertEqual(handle("/attachments/../secret.txt"), (404, "not found"))
+                self.assertEqual(handle("/attachments/..%2Fsecret.txt"), (404, "not found"))
+                self.assertEqual(handle("/attachments/%2e%2e%2fsecret.txt"), (404, "not found"))
+                self.assertEqual(handle("/attachments/%2e%2e/secret.txt"), (404, "not found"))
+                self.assertEqual(handle(f"/attachments/{secret}"), (404, "not found"))
+                self.assertEqual(handle(f"/attachments/%2F{str(secret).lstrip('/')}"), (404, "not found"))
+                self.assertEqual(handle("/attachments/%2Fetc%2Fpasswd"), (404, "not found"))
+                self.assertEqual(handle("/attachments/a.txt%00"), (404, "not found"))
+                self.assertEqual(handle("/attachments/a.txt%5Cx"), (404, "not found"))
+
+                # Un symlink dentro de la carpeta que apunta fuera no se sigue.
+                link = Path(uploads, "link.txt")
+                if hasattr(os, "symlink"):
+                    try:
+                        os.symlink(secret, link)
+                    except OSError:
+                        self.skipTest("el entorno no permite symlinks")
+                    self.assertEqual(handle("/attachments/link.txt"), (404, "not found"))
+
+
+if __name__ == "__main__":
+    unittest.main()
