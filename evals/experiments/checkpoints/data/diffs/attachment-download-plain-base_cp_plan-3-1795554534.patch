@@ -1,5 +1,6 @@
 import unittest
 
+from app.config import ROOT, UPLOAD_DIR
 from app.routes import handle
 
 
@@ -11,3 +12,33 @@ class RoutesTest(unittest.TestCase):
         self.assertEqual(handle("/invoices/1001"), (200, "Acme: 120.00"))
         self.assertEqual(handle("/invoices/10%30%31"), (200, "Acme: 120.00"))
         self.assertEqual(handle("/invoices/9"), (404, "not found"))
+
+    def test_attachment(self):
+        for name in ("manual.txt", "notas.txt"):
+            expected = (UPLOAD_DIR / name).read_text(encoding="utf-8")
+            self.assertEqual(handle(f"/attachments/{name}"), (200, expected))
+        self.assertEqual(handle("/attachments/no-existe.txt"), (404, "not found"))
+
+    def test_attachment_rejects_folder_itself(self):
+        for path in ("/attachments/", "/attachments/.", "/attachments/%2e", "/attachments/.."):
+            self.assertEqual(handle(path), (404, "not found"), path)
+
+    def test_attachment_rejects_traversal(self):
+        # secrets.txt existe justo fuera de uploads/, así que el 404 es por la validación.
+        self.assertTrue((ROOT / "secrets.txt").is_file())
+        paths = (
+            "/attachments/..%2Fsecrets.txt",
+            "/attachments/%2e%2e%2fsecrets.txt",
+            "/attachments/..%2F..%2Fsecrets.txt",
+            "/attachments/%2e%2e/secrets.txt",
+            "/attachments/..%5Csecrets.txt",
+            "/attachments/%2e%2e%5c",
+            "/attachments/%2Fetc%2Fpasswd",
+            "/attachments//" + str(ROOT / "secrets.txt"),
+            "/attachments/%252e%252e%252fsecrets.txt",
+        )
+        for path in paths:
+            self.assertEqual(handle(path), (404, "not found"), path)
+
+    def test_attachment_rejects_subfolders(self):
+        self.assertEqual(handle("/attachments/a%2Fb.txt"), (404, "not found"))
