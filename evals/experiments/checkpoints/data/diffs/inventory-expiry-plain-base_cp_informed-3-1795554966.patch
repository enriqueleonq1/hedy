+from shop.errors import NotEnoughStock, ReservationExpired
+from shop.inventory import RESERVATION_TTL, Inventory
 from shop.report import pending_report
 
 
@@ -34,3 +34,51 @@ class InventoryTest(unittest.TestCase):
     def test_report(self):
         self.inv.reserve("A1", 1)
         self.assertEqual(pending_report(self.inv), "#1 Lámpara x1")
+
+    def test_reservation_is_valid_just_before_ttl(self):
+        r = self.inv.reserve("A1", 3)
+        self.clock.now += RESERVATION_TTL - 1
+        self.assertEqual(self.inv.available("A1"), 2)
+        self.inv.confirm(r.id)
+        self.assertEqual(self.inv.product("A1").stock, 2)
+
+    def test_reservation_expires_at_exactly_ttl(self):
+        r = self.inv.reserve("A1", 3)
+        self.clock.now += RESERVATION_TTL
+        self.assertEqual(self.inv.available("A1"), 5)
+        with self.assertRaises(ReservationExpired):
+            self.inv.confirm(r.id)
+        self.assertEqual(self.inv.product("A1").stock, 5)
+
+    def test_expired_stock_can_be_reserved_again(self):
+        self.inv.reserve("A1", 5)
+        self.clock.now += RESERVATION_TTL
+        self.inv.reserve("A1", 5)
+        self.assertEqual(self.inv.available("A1"), 0)
+
+    def test_release_expired_removes_only_expired_unconfirmed(self):
+        old = self.inv.reserve("A1", 1)
+        confirmed = self.inv.reserve("A1", 1)
+        self.inv.confirm(confirmed.id)
+        self.clock.now += RESERVATION_TTL
+        fresh = self.inv.reserve("A1", 1)
+        self.assertEqual(self.inv.release_expired(), 1)
+        ids = [r.id for r in self.inv.reservations()]
+        self.assertNotIn(old.id, ids)
+        self.assertIn(confirmed.id, ids)
+        self.assertIn(fresh.id, ids)
+        self.assertEqual(self.inv.release_expired(), 0)
+
+    def test_confirmed_reservations_never_expire(self):
+        r = self.inv.reserve("A1", 2)
+        self.inv.confirm(r.id)
+        self.clock.now += 10 * RESERVATION_TTL
+        self.assertEqual(self.inv.release_expired(), 0)
+        self.assertEqual(self.inv.product("A1").stock, 3)
+        self.assertEqual(self.inv.available("A1"), 3)
+
+    def test_report_hides_expired(self):
+        self.inv.reserve("A1", 1)
+        self.clock.now += RESERVATION_TTL
+        fresh = self.inv.reserve("A1", 2)
+        self.assertEqual(pending_report(self.inv), f"#{fresh.id} Lámpara x2")
