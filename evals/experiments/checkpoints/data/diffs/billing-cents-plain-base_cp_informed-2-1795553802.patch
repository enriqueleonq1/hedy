diff --git a/tests/test_cents.py b/tests/test_cents.py
new file mode 100644
index 0000000..737bd2b
--- /dev/null
+++ b/tests/test_cents.py
@@ -0,0 +1,20 @@
+import unittest
+
+from billing.coupons import discount
+from billing.invoice import money
+from billing.tax import tax
+
+
+class CentsTest(unittest.TestCase):
+    def test_tax_rounds_half_up(self):
+        # 1200 * 8.875 % = 106.5 centavos -> 107 (la mitad sube, no al par).
+        self.assertEqual(tax(1200, "NY"), 107)
+
+    def test_percent_discount_rounds_half_up(self):
+        # 115 * 50 % = 57.5 centavos -> 58.
+        self.assertEqual(discount(115, "HALF"), 58)
+
+    def test_money_formats_cents(self):
+        self.assertEqual(money(1234567), "$12,345.67")
+        self.assertEqual(money(5), "$0.05")
+        self.assertEqual(money(-500), "$-5.00")
