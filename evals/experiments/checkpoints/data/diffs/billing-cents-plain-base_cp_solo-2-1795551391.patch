diff --git a/billing/money.py b/billing/money.py
new file mode 100644
index 0000000..9819b4b
--- /dev/null
+++ b/billing/money.py
@@ -0,0 +1,10 @@
+# All money in billing/ is an int number of cents.
+
+
+def portion(cents, part, whole):
+    """Return cents * part / whole, rounded half up to the nearest cent.
+
+    Only integer arithmetic is used, so there are no float rounding errors.
+    Expects non-negative amounts.
+    """
+    return (cents * part + whole // 2) // whole
