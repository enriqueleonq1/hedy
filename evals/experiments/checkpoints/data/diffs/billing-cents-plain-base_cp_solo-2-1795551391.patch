diff --git a/tests/test_money.py b/tests/test_money.py
new file mode 100644
index 0000000..99684df
--- /dev/null
+++ b/tests/test_money.py
@@ -0,0 +1,34 @@
+import unittest
+
+from billing.cart import Cart
+from billing.catalog import PRICES
+from billing.invoice import invoice_text, money
+from billing.money import portion
+
+
+class MoneyTest(unittest.TestCase):
+    def test_prices_are_int_cents(self):
+        self.assertTrue(all(isinstance(p, int) for p in PRICES.values()))
+
+    def test_money_format(self):
+        self.assertEqual(money(5), "$0.05")
+        self.assertEqual(money(100000), "$1,000.00")
+
+    def test_portion_rounds_half_up(self):
+        self.assertEqual(portion(1, 50, 100), 1)
+        self.assertEqual(portion(1, 49, 100), 0)
+
+    def test_tax_with_cents(self):
+        cart = Cart()
+        cart.add("pen", 3)
+        self.assertEqual(
+            invoice_text(cart, "NY"),
+            "3 x pen: $3.45\nSubtotal: $3.45\nImpuesto: $0.31\nTotal: $3.76",
+        )
+
+    def test_percent_coupon_rounds_to_cent(self):
+        cart = Cart()
+        cart.add("chair")
+        text = invoice_text(cart, "OR", "TEN")
+        self.assertIn("Descuento: -$9.00", text)
+        self.assertTrue(text.endswith("Total: $80.95"))
