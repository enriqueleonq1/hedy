@@ -0,0 +1,53 @@
+import unittest
+from decimal import Decimal
+
+from reports.summary import monthly_summary
+
+
+class MonthlySummaryTest(unittest.TestCase):
+    def test_adds_only_the_requested_month(self):
+        sales = [
+            {"date": "2025-03-01", "amount": "10.10"},
+            {"date": "2025-03-28", "amount": "4.90"},
+            {"date": "2025-04-01", "amount": "100"},
+            {"date": "2025-02-28", "amount": "100"},
+        ]
+        with self.assertLogs("reports.summary", level="INFO") as logs:
+            total = monthly_summary(sales, "2025-03")
+        self.assertEqual(total, Decimal("15.00"))
+        self.assertIn("2025-03", logs.output[0])
+        self.assertIn("15.00", logs.output[0])
+
+    def test_excludes_same_month_of_another_year(self):
+        sales = [
+            {"date": "2024-03-15", "amount": "50"},
+            {"date": "2025-03-15", "amount": "7"},
+        ]
+        self.assertEqual(monthly_summary(sales, "2025-03"), Decimal("7"))
+
+    def test_accepts_numeric_amounts(self):
+        sales = [{"date": "2025-03-01", "amount": 10.5}, {"date": "2025-03-02", "amount": 2}]
+        self.assertEqual(monthly_summary(sales, "2025-03"), Decimal("12.5"))
+
+    def test_keeps_decimal_precision(self):
+        sales = [{"date": "2025-03-01", "amount": "0.10"}, {"date": "2025-03-02", "amount": "0.20"}]
+        self.assertEqual(monthly_summary(sales, "2025-03"), Decimal("0.30"))
+
+    def test_empty_list_returns_zero(self):
+        self.assertEqual(monthly_summary([], "2025-03"), Decimal("0"))
+
+    def test_month_without_sales_returns_zero(self):
+        sales = [{"date": "2025-03-01", "amount": "10"}]
+        self.assertEqual(monthly_summary(sales, "2025-05"), Decimal("0"))
+
+    def test_malformed_month_returns_zero(self):
+        sales = [{"date": "2025-03-01", "amount": "10"}]
+        self.assertEqual(monthly_summary(sales, "2025-3"), Decimal("0"))
+
+    def test_returns_decimal_not_float(self):
+        sales = [{"date": "2025-03-01", "amount": 1}]
+        self.assertIsInstance(monthly_summary(sales, "2025-03"), Decimal)
+
+
+if __name__ == "__main__":
+    unittest.main()
