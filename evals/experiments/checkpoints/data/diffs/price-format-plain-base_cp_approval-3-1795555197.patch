@@ -0,0 +1,28 @@
+import unittest
+
+from shop.catalog import CATALOG, Product, format_price
+
+
+class FormatPriceTests(unittest.TestCase):
+    def test_formats_catalog_prices(self):
+        self.assertEqual(format_price(CATALOG[0]), "USD 12.50")
+        self.assertEqual(format_price(CATALOG[1]), "USD 9.00")
+
+    def test_zero(self):
+        self.assertEqual(format_price(Product("Gratis", 0)), "USD 0.00")
+
+    def test_less_than_ten_cents_keeps_two_decimals(self):
+        self.assertEqual(format_price(Product("Moneda", 5)), "USD 0.05")
+
+    def test_exact_euros_keeps_two_decimals(self):
+        self.assertEqual(format_price(Product("Servicio", 100)), "USD 1.00")
+
+    def test_no_thousands_separator(self):
+        self.assertEqual(format_price(Product("Pack", 123456)), "USD 1234.56")
+
+    def test_uses_integer_cents_not_float(self):
+        self.assertEqual(format_price(Product("Caro", 1999)), "USD 19.99")
+
+
+if __name__ == "__main__":
+    unittest.main()
