+
+
+class ExpiryTest(unittest.TestCase):
+    def setUp(self):
+        self.clock = Clock()
+        self.inv = Inventory(self.clock)
+        self.inv.add_product("A1", "Lámpara", 5)
+
+    def test_reservation_still_holds_stock_one_second_before_15_minutes(self):
+        self.inv.reserve("A1", 3)
+        self.clock.now = 1899.0
+        self.assertEqual(self.inv.reserved("A1"), 3)
+        self.assertEqual(self.inv.available("A1"), 2)
+
+    def test_reservation_expires_exactly_at_15_minutes(self):
+        self.inv.reserve("A1", 3)
+        self.clock.now = 1900.0
+        self.assertEqual(self.inv.reserved("A1"), 0)
+        self.assertEqual(self.inv.available("A1"), 5)
+        self.assertEqual(self.inv.reserve("A1", 5).qty, 5)
+
+    def test_confirm_before_expiry_takes_stock(self):
+        r = self.inv.reserve("A1", 2)
+        self.clock.now = 1899.0
+        self.inv.confirm(r.id)
+        self.assertEqual(self.inv.product("A1").stock, 3)
+
+    def test_confirm_expired_raises_and_changes_nothing(self):
+        r = self.inv.reserve("A1", 2)
+        self.clock.now = 1900.0
+        with self.assertRaises(ReservationExpired):
+            self.inv.confirm(r.id)
+        self.assertEqual(self.inv.product("A1").stock, 5)
+        self.assertFalse(self.inv.reservation(r.id).confirmed)
+
+    def test_ttl_is_configurable(self):
+        inv = Inventory(self.clock, ttl=60)
+        inv.add_product("B2", "Silla", 2)
+        inv.reserve("B2", 2)
+        self.clock.now = 1059.0
+        self.assertEqual(inv.available("B2"), 0)
+        self.clock.now = 1060.0
+        self.assertEqual(inv.available("B2"), 2)
+
+    def test_release_expired_returns_count_and_frees_only_expired(self):
+        self.inv.reserve("A1", 1)
+        self.inv.reserve("A1", 1)
+        self.clock.now = 1500.0
+        self.inv.reserve("A1", 1)
+        self.clock.now = 1900.0
+        self.assertEqual(self.inv.release_expired(), 2)
+        self.assertEqual(self.inv.release_expired(), 0)
+        self.assertEqual(len(self.inv.reservations()), 1)
+        self.assertEqual(self.inv.reserved("A1"), 1)
+        self.assertEqual(self.inv.product("A1").stock, 5)
+
+    def test_release_expired_with_nothing_expired_returns_zero(self):
+        self.inv.reserve("A1", 1)
+        self.assertEqual(self.inv.release_expired(), 0)
+        self.assertEqual(len(self.inv.reservations()), 1)
+
+    def test_confirmed_reservation_never_expires(self):
+        r = self.inv.reserve("A1", 2)
+        self.inv.confirm(r.id)
+        self.clock.now = 5000.0
+        self.assertEqual(self.inv.release_expired(), 0)
+        self.assertIs(self.inv.confirm(r.id), self.inv.reservation(r.id))
+        self.assertEqual(self.inv.product("A1").stock, 3)
+        self.assertEqual(self.inv.available("A1"), 3)
+        self.assertEqual(len(self.inv.reservations()), 1)
+
+    def test_report_hides_expired_and_keeps_active(self):
+        self.inv.reserve("A1", 1)
+        self.clock.now = 1500.0
+        self.inv.reserve("A1", 2)
+        self.clock.now = 1900.0
+        self.assertEqual(pending_report(self.inv), "#2 Lámpara x2")
+
+    def test_report_hides_confirmed(self):
+        r = self.inv.reserve("A1", 1)
+        self.inv.confirm(r.id)
+        self.assertEqual(pending_report(self.inv), "")
