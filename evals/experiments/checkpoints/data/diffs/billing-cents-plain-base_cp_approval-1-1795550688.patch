+    "SAVE5": ("fixed", 500),
     "HALF": ("percent", 50),
-    "BIG": ("fixed", 100.0),
+    "BIG": ("fixed", 10000),
 }
 
 
 def discount(subtotal, code):
     if code is None:
-        return 0.0
+        return 0
