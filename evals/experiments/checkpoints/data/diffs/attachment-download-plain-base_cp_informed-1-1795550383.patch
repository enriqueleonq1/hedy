     return 200, f"{found['customer']}: {found['total']}"
 
 
+def attachment(name):
+    # `name` ya viene decodificado por handle(), así que %2e%2e%2f llega como "../".
+    if not name or "\x00" in name or "/" in name or "\\" in name:
+        return 404, "not found"
+    base = config.UPLOAD_DIR.resolve()
+    # resolve() sigue symlinks: un enlace dentro de uploads que apunte fuera queda fuera.
+    target = (base / name).resolve()
+    if target.parent != base or not target.is_file():
+        return 404, "not found"
+    return 200, target.read_text(encoding="utf-8")
+
+
