+"""Reporte mensual."""
+
+from decimal import Decimal
+
+
+def monthly_summary(sales, month):
+    """Total vendido en `month` ('AAAA-MM') y lo muestra en la consola."""
+    total = sum(
+        (Decimal(str(s["amount"])) for s in sales if s["date"][:7] == month),
+        Decimal("0"),
+    )
+    print(f"Ventas de {month}: {total}")
+    return total
