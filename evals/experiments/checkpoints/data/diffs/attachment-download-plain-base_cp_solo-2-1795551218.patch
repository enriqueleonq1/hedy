+def attachment(name):
+    base = config.UPLOAD_DIR.resolve()
+    path = (base / name).resolve()
+    if not path.is_relative_to(base) or not path.is_file():
+        return 404, "not found"
+    return 200, path.read_text(encoding="utf-8")
