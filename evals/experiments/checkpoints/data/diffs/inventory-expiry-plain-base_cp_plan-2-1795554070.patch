+from shop.errors import NotEnoughStock, ReservationExpired
+from shop.inventory import RESERVATION_TTL, Inventory
 from shop.report import pending_report
 
 
@@ -34,3 +34,50 @@ class InventoryTest(unittest.TestCase):
     def test_report(self):
         self.inv.reserve("A1", 1)
         self.assertEqual(pending_report(self.inv), "#1 Lámpara x1")
+
+    def test_reservation_holds_stock_until_it_expires(self):
+        self.inv.reserve("A1", 3)
+        self.clock.now += RESERVATION_TTL - 1
+        self.assertEqual(self.inv.available("A1"), 2)
+
+    def test_expired_reservation_returns_stock_without_release(self):
+        self.inv.reserve("A1", 3)
+        self.clock.now += RESERVATION_TTL
+        self.assertEqual(self.inv.available("A1"), 5)
+
+    def test_release_expired_counts_each_reservation_once(self):
+        self.inv.reserve("A1", 1)
+        self.inv.reserve("A1", 1)
+        self.clock.now += RESERVATION_TTL
+        self.assertEqual(self.inv.release_expired(), 2)
+        self.assertEqual(self.inv.release_expired(), 0)
+
+    def test_release_expired_skips_fresh_and_confirmed(self):
+        old = self.inv.reserve("A1", 1)
+        self.clock.now += RESERVATION_TTL - 1
+        self.inv.confirm(old.id)
+        fresh = self.inv.reserve("A1", 1)
+        self.clock.now += RESERVATION_TTL - 1
+        self.assertEqual(self.inv.release_expired(), 0)
+        self.assertFalse(fresh.expired)
+        self.assertTrue(old.confirmed)
+
+    def test_confirm_expired_reservation_fails_without_taking_stock(self):
+        r = self.inv.reserve("A1", 2)
+        self.clock.now += RESERVATION_TTL
+        with self.assertRaises(ReservationExpired):
+            self.inv.confirm(r.id)
+        self.assertEqual(self.inv.product("A1").stock, 5)
+
+    def test_confirm_before_expiry_still_works(self):
+        r = self.inv.reserve("A1", 2)
+        self.clock.now += RESERVATION_TTL - 1
+        self.inv.confirm(r.id)
+        self.clock.now += RESERVATION_TTL * 10
+        self.assertEqual(self.inv.product("A1").stock, 3)
+
+    def test_report_hides_expired_reservations(self):
+        self.inv.reserve("A1", 1)
+        self.clock.now += RESERVATION_TTL
+        self.inv.reserve("A1", 2)
+        self.assertEqual(pending_report(self.inv), "#2 Lámpara x2")
