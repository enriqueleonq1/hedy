-# A coupon is ("percent", 10) for 10 % off, or ("fixed", 5.0) for 5 dollars off.
+# A coupon is ("percent", 10) for 10 % off, or ("fixed", 500) for 500 cents off.
 COUPONS = {
     "TEN": ("percent", 10),
-    "SAVE5": ("fixed", 5.0),
+    "SAVE5": ("fixed", 500),
     "HALF": ("percent", 50),
-    "BIG": ("fixed", 100.0),
+    "BIG": ("fixed", 10000),
 }
 
 
 def discount(subtotal, code):
     if code is None:
-        return 0.0
+        return 0
     kind, value = COUPONS[code]
     if kind == "percent":
-        return round(subtotal * value / 100, 2)
+        # Integer division rounding half up to the nearest cent.
+        return (subtotal * value + 50) // 100
     return min(value, subtotal)
