+    def test_attachment(self):
+        notas = (UPLOAD_DIR / "notas.txt").read_text(encoding="utf-8")
+        self.assertEqual(handle("/attachments/notas.txt"), (200, notas))
+        self.assertEqual(handle("/attachments/nope.txt"), (404, "not found"))
+
+    def test_attachment_rejects_paths_outside_uploads(self):
+        for path in (
+            "/attachments/../secrets.txt",
+            "/attachments/..%2Fsecrets.txt",
+            "/attachments/%2e%2e%2fsecrets.txt",
+            "/attachments/" + quote(str(ROOT / "secrets.txt"), safe=""),
+            "/attachments/sub%2Fx.txt",
+            "/attachments/",
+            "/attachments/.",
+        ):
+            with self.subTest(path=path):
+                self.assertEqual(handle(path), (404, "not found"))
